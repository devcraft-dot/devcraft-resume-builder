# --- Production build (required unless dashboard is served from the API host) ---
# Full origin of the FastAPI app, no trailing slash.
# VITE_API_URL=https://your-app.vercel.app

# --- Local dev (optional) ---
# When VITE_API_URL is unset, the dashboard calls /api on the Vite dev server, which
# proxies to this URL (default: uvicorn on port 8000).
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000
