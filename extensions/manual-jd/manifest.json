{
  "manifest_version": 3,
  "name": "Resume Builder — Manual JD",
  "version": "1.4.0",
  "description": "Paste a job description and generate resumes via the same API as the Indeed extension",
  "permissions": ["storage", "sidePanel", "tabs", "scripting"],
  "host_permissions": [
    "https://devcraft-resume-builder.vercel.app/*",
    "https://job-boards.greenhouse.io/*",
    "http://job-boards.greenhouse.io/*",
    "https://boards.greenhouse.io/*",
    "http://boards.greenhouse.io/*",
    "https://*.greenhouse.io/*",
    "http://*.greenhouse.io/*",
    "https://jobs.ashbyhq.com/*",
    "http://jobs.ashbyhq.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Resume Builder — Manual JD",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["manualExtensionCore.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/icon16.png", "icons/icon48.png", "icons/icon128.png"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
